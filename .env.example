# ===== JobFit AI 环境变量 =====
# 复制为 .env.local 后填写。所有变量仅用于服务端 API Routes，不会下发到浏览器。

# OpenAI API Key（必填）
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# OpenAI 兼容接口地址（可选）
# 官方：https://api.openai.com/v1
# 第三方兼容网关 / 本地 vLLM / Ollama / DeepSeek / 通义 均填这里，末尾不要带斜杠
OPENAI_BASE_URL=https://api.openai.com/v1

# 使用的模型（可选，默认 gpt-4o-mini）
MODEL=gpt-4o-mini

# 单次生成的温度（可选，默认 0.2，评分任务建议低温度）
MODEL_TEMPERATURE=0.2

# 采样种子（可选，默认 42）。固定种子让相同输入产生相同输出，减少分数波动。
# 设 off / none / random 可关闭（例如换用不支持 seed 的上游）。
MODEL_SEED=42

# 兼容模式（可选）
# 默认 compatible：走 chat/completions 协议，适用于绝大多数第三方兼容网关与本地模型。
# 直连 OpenAI 官方 API 需要 strict structured outputs 时，设为 strict。
MODEL_COMPATIBILITY=compatible

# 结构化输出通道（可选，默认 auto）
# auto：先用 response_format: json_object，被上游拒绝时自动降级为"纯文本 + 本地提取校验"
# json：只用 response_format
# tool：用 function calling（需要模型支持 tool_choice，思考模型通常不支持）
# text：完全不依赖服务端结构化能力，全部由本地提取并校验
#
# 遇到 "Thinking mode does not support this tool_choice" 或不支持 response_format 的网关，
# 保持 auto 即可自动兜住；想强制走某条通道再显式指定。
MODEL_OBJECT_MODE=auto
